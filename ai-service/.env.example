# SafeTour AI - AI Service Environment Variables

# Port for the AI Flask Service
PORT=5001

# Overpass API endpoint for OSM road graph queries (optional custom mirror)
OVERPASS_URL=https://overpass-api.de/api/interpreter

# OpenWeather API Key (optional for real-time flood/weather risk data later)
OPENWEATHER_API_KEY=

# MongoDB URI (for referencing SafeTour POI cache / road-block reporting)
MONGODB_URI=mongodb://localhost:27017/safetour

# Default Bounding Box / Area for road network
DEFAULT_LOCATION_NAME=Krishnankoil, Tamil Nadu, India

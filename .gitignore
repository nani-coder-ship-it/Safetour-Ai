# ==============================================================================
# SafeTour AI - Strict Security & Git Ignore Configuration
# ==============================================================================

# Environment variables & secrets (CRITICAL: NEVER COMMIT SECRETS)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
*.pem
*.key
*.cert

# Firebase Credentials & Configuration (DO NOT COMMIT REAL PROJECT KEYS)
**/google-services.json
!**/google-services.json.example
**/GoogleService-Info.plist
!**/GoogleService-Info.plist.example
**/firebase_options.dart
!**/firebase_options.dart.example
**/firebase.json

# Node.js / Backend dependencies & logs
node_modules/
backend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# Flutter & Dart dependencies & build cache
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
mobile-app/safetour_ai/build/
mobile-app/safetour_ai/.dart_tool/
mobile-app/safetour_ai/.flutter-plugins-dependencies

# Android build outputs & local properties
**/.gradle/
**/local.properties
**/android/app/debug
**/android/app/profile
**/android/app/release
*.apk
*.aab

# Log files
*.log
*.log.*
mobile-app/safetour_ai/*.log

# IDE and OS files
.idea/
.vscode/
*.iml
*.ipr
*.iws
.DS_Store
Thumbs.db

# Python virtual environments & cache
venv/
ENV/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
ai-service/venv/
ai-service/cache/
ai-service/.env
ai-service/.env.*
!ai-service/.env.example
ai-service/models/*.pt
ai-service/models/*.pth
ai-service/models/*.onnx

# Large raw datasets (> 100MB)
*.pbf
*.osm.pbf
ai-service/data/raw/*.pbf
ai-service/data/raw/*.osm.pbf
